# Cache static assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache images
*.png
  Cache-Control: public, max-age=31536000, immutable
*.jpg
  Cache-Control: public, max-age=31536000, immutable
*.jpeg
  Cache-Control: public, max-age=31536000, immutable
*.webp
  Cache-Control: public, max-age=31536000, immutable
*.svg
  Cache-Control: public, max-age=31536000, immutable

# HTML - shorter cache for updates
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

# Main page
/
  Cache-Control: public, max-age=3600, must-revalidate
  
# Enable compression
/*
  Content-Encoding: gzip
